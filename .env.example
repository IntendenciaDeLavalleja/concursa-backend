# Variables de ejecución. Usá Environment Variables de Coolify con Runtime.
SECRET_KEY=
WTF_CSRF_SECRET_KEY=
FRONTEND_URL=https://concursa.example.org
# Opcional. Reemplaza la lista de orígenes permitidos. Incluí FRONTEND_URL.
CORS_ORIGINS=
SESSION_COOKIE_SECURE=True
PROXY_FIX_X_FOR=1
GUNICORN_WORKERS=4

# URL de MariaDB accesible desde el contenedor. DATABASE_URI también se admite.
DATABASE_URL=mariadb+mariadbconnector://usuario:password@mariadb:3306/concursos
REDIS_URL=redis://redis:6379/0

# Copiá los valores del SMTP institucional desde la configuración existente.
MAIL_SERVER=smtp.example.org
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=concursos@example.org

# MINIO_ENDPOINT admite host[:puerto]. Usá un bucket dedicado.
MINIO_ENDPOINT=archivos.example.org
MINIO_SECURE=True
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=concursos
MINIO_PUBLIC_URL=https://archivos.example.org
MINIO_REQUIRED=True
